# Copy to backend/.env and adjust as needed.

# Postgres: user, password, port and DB name must match the root .env
DATABASE_URL=postgresql+asyncpg://saydo:change-me@localhost:5432/saydo
TEST_DATABASE_URL=postgresql+asyncpg://saydo:change-me@localhost:5432/saydo_test

# Uploaded PDFs; relative paths resolve against backend/
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# LLM claim extraction (Groq). LLM_PROVIDER=fake never calls the network.
GROQ_API_KEY=
LLM_PROVIDER=groq
EXTRACTION_MODEL=openai/gpt-oss-120b
# Groq no longer serves llama-3.1-8b-instant; gpt-oss-20b is the closest small model
FAST_MODEL=openai/gpt-oss-20b
# Free-tier limits (per organization): tokens and requests per rolling minute
LLM_TPM_LIMIT=8000
LLM_RPM_LIMIT=30
LLM_REASONING_EFFORT=low
# Skip chunks without forward-looking keywords before calling the LLM
EXTRACTION_PREFILTER=true
# Also skip pleasantry-only chunks and short chunks with no numeric/dated outlook
EXTRACTION_STRICT_PREFILTER=true
# extract-v2 sends several chunks per request (extract-v1: one chunk per request)
EXTRACTION_PROMPT_VERSION=extract-v2
EXTRACTION_BATCH_MAX_TOKENS=2500
EXTRACTION_BATCH_MAX_CHUNKS=6
# Expected reply tokens per batch (~9 claims); claim-dense chunks are sent on their own
EXTRACTION_BATCH_MAX_OUTPUT_TOKENS=1500
# Extract claims automatically after processing (off: the daily quota is small)
AUTO_EXTRACT=false

# Embeddings: "gemini" (gemini-embedding-001) or "fake" (deterministic, offline; for tests)
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
# Must match the chunks.embedding column, vector(768)
EMBEDDING_DIM=768
# Minimum seconds between embedding API requests (free-tier rate limits)
EMBEDDING_MIN_REQUEST_INTERVAL_S=1.0

# Verification (link + verify runs). Read endpoints never call Groq or Gemini.
VERIFY_MODEL=openai/gpt-oss-120b
# Most LLM calls one link/verify run may make (ambiguous links + qualitative verdicts)
VERIFY_MAX_LLM_CALLS=30
# A miss within this % of the target is still "missed" but flagged near_miss
VERIFY_TOLERANCE_PCT=0
# Directional claims: changes within +/- this % count as "maintained"
VERIFY_DIRECTIONAL_BAND_PCT=2
# A promise absent from this many of the latest calls (target period still open) is dropped
VERIFY_DROPPED_AFTER_CALLS=2
VERIFY_LINK_BATCH_SIZE=15
# One extra LLM call per missed/delayed/dropped thread for a short explanation summary
VERIFY_SUMMARIZE_EXPLANATIONS=false
