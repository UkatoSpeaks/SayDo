# Copy to backend/.env and adjust as needed.

# Postgres: user, password, port and DB name must match the root .env
DATABASE_URL=postgresql+asyncpg://saydo:change-me@localhost:5432/saydo
TEST_DATABASE_URL=postgresql+asyncpg://saydo:change-me@localhost:5432/saydo_test

# Uploaded PDFs; relative paths resolve against backend/
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# LLM (used from Prompt 3 onwards)
GROQ_API_KEY=

# Embeddings: "gemini" (gemini-embedding-001) or "fake" (deterministic, offline; for tests)
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
# Must match the chunks.embedding column, vector(768)
EMBEDDING_DIM=768
# Minimum seconds between embedding API requests (free-tier rate limits)
EMBEDDING_MIN_REQUEST_INTERVAL_S=1.0
